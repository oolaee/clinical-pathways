{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions plus authorization to run the bundled llama.cpp sidecar for on-device inference.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/llama-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "updater:default",
    "process:default"
  ]
}
